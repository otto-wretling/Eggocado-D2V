              "value": "=export PATH=/opt/homebrew/bin:/usr/local/bin:$PATH && DUR=$(ffprobe -v quiet -show_entries format=duration -of csv=p=0 temp/{{$node[\"Process Pages One by One\"].context.currentRunIndex}}_audio.wav) && ffmpeg -y -loop 1 -t \"$DUR\" -i temp/{{$node[\"Process Pages One by One\"].context.currentRunIndex}}_image.png -i temp/{{$node[\"Process Pages One by One\"].context.currentRunIndex}}_audio.wav -vf \"scale=trunc(iw/2)*2:trunc(ih/2)*2\" -c:v libx264 -tune stillimage -c:a aac -b:a 192k -pix_fmt yuv420p temp/{{$node[\"Process Pages One by One\"].context.currentRunIndex}}_clip.mp4"
